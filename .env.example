# fusion-harness provider keys — copy to .env and fill in.
# `set dotenv-load := true` in the justfile exports these for every recipe.

# anthropic/* slots (e.g. claude-fable-5 architect)
ANTHROPIC_API_KEY=

# google/* slots — pi reads GEMINI_API_KEY for the google provider
# (NOT GOOGLE_GENERATIVE_AI_API_KEY).
GEMINI_API_KEY=

# fireworks/* slots (DeepSeek V4 Pro/Flash, Kimi K3, ...)
FIREWORKS_API_KEY=

# openai/* slots (gpt-5.6-sol / terra)
OPENAI_API_KEY=

# openrouter/* slots
OPENROUTER_API_KEY=
