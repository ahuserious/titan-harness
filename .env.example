# titan-harness provider keys — copy to .env and fill in.
# `set dotenv-load := true` in the justfile exports these for every recipe.

# anthropic/* slots (e.g. claude-fable-5 architect)
ANTHROPIC_API_KEY=

# google/* slots — pi reads GEMINI_API_KEY for the google provider
# (NOT GOOGLE_GENERATIVE_AI_API_KEY).
GEMINI_API_KEY=

# fireworks/* slots (DeepSeek V4 Pro/Flash, Kimi K3, ...)
FIREWORKS_API_KEY=

# openai/* slots (gpt-5.6-sol / terra)
OPENAI_API_KEY=

# openrouter/* slots
OPENROUTER_API_KEY=

# MCP catalog servers and verify lanes that take an env credential (mcp/mcp.json,
# docs/named-links.md). Leave a value empty to keep that server disabled; never commit values.
# InfraNodus (catalog server `infranodus`, shipped "disabled": true until keyed)
INFRANODUS_API_KEY=
# Cursor cloud agents (verify runner; the lane reports vacant without it)
CURSOR_API_KEY=
# Momentic (catalog server `momentic`, disabled until keyed; also needs MOMENTIC_CONFIG)
MOMENTIC_API_KEY=
# Brandfetch bearer for the bash bridges (`bf1…` MCP token); the interactive host uses OAuth
BRANDFETCH_MCP_TOKEN=
